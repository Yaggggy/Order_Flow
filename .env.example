# Use python scripts/setup_env.py to generate .env with independent random secrets.
# These placeholders are NOT suitable for a running deployment.
CLICKHOUSE_ADMIN_PASSWORD=REPLACE_WITH_32_RANDOM_CHARACTERS
CLICKHOUSE_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_PASSWORD
API_KEY=REPLACE_WITH_RANDOM_API_KEY
INGESTION_MODE=synthetic
SYMBOLS=BTCUSDT
SYNTHETIC_TICKS_PER_SECOND=1500
BROADCAST_LOOKBACK_MINUTES=3
MAX_PRICE_LEVELS=50000
# Browser WebSocket origins are denied unless explicitly listed; native clients
# without Origin still authenticate. Comma-separated exact origins, no wildcard.
ALLOWED_ORIGINS=
